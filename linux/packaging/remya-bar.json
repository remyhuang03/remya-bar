{
  "version": 1,
  "id": "remya-bar",
  "app": "top.remya.bar",
  "title": "Remya Bar",
  "icon": "top.remya.bar",
  "config": "bar",
  "pages": [
    {
      "id": "layout",
      "title": "Layout",
      "keywords": []
    },
    {
      "id": "osd",
      "title": "On-screen display",
      "keywords": []
    },
    {
      "id": "notifications",
      "title": "Notifications",
      "keywords": []
    },
    {
      "id": "ai-ring",
      "title": "AI quota rings",
      "keywords": []
    }
  ],
  "settings": {
    "layout": {
      "title": "Bar layout",
      "page": "layout",
      "keywords": [],
      "default": {
        "groups": [
          [
            "notifications",
            "window",
            "resources"
          ],
          [
            "workspaces",
            "clock"
          ],
          [
            "tray"
          ],
          [
            "ai-usage",
            "battery",
            "sidebar"
          ]
        ],
        "workspace-count": 8,
        "resources": [
          "cpu",
          "memory",
          "network"
        ],
        "window-app-name": false,
        "media-marquee": false,
        "center": 1
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "groups": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "array",
              "items": {
                "enum": [
                  "notifications",
                  "window",
                  "resources",
                  "media",
                  "workspaces",
                  "clock",
                  "tray",
                  "ai-usage",
                  "battery",
                  "sidebar"
                ]
              },
              "uniqueItems": true,
              "minItems": 1,
              "maxItems": 10
            },
            "contains": {
              "contains": {
                "const": "sidebar"
              }
            }
          },
          "workspace-count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "resources": {
            "type": "array",
            "items": {
              "enum": [
                "cpu",
                "memory",
                "gpu",
                "network"
              ]
            },
            "uniqueItems": true,
            "minItems": 1,
            "maxItems": 4
          },
          "window-app-name": {
            "type": "boolean"
          },
          "media-marquee": {
            "type": "boolean"
          },
          "center": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9
          }
        },
        "required": [
          "groups",
          "workspace-count",
          "resources",
          "window-app-name",
          "media-marquee"
        ],
        "additionalProperties": false
      }
    },
    "clock-seconds": {
      "title": "Clock seconds",
      "page": "layout",
      "keywords": [],
      "default": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "boolean"
      }
    },
    "keyboard-preview": {
      "title": "Keyboard preview",
      "page": "layout",
      "keywords": [],
      "default": true,
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "boolean"
      }
    },
    "folded-apps": {
      "title": "Tray overflow apps",
      "page": "layout",
      "keywords": [],
      "default": [],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "uniqueItems": true
      }
    },
    "sidebar-layout": {
      "title": "Sidebar layout",
      "page": "layout",
      "keywords": [],
      "default": [
        "internet",
        "bluetooth",
        "audio",
        "night-light",
        "dnd",
        "power",
        "caffeine",
        "record",
        "screenshot",
        "picker",
        "dark",
        "dnd-quick",
        "airplane",
        "keyboard",
        "clipboard",
        "mic-mute"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "array",
        "items": {
          "enum": [
            "internet",
            "bluetooth",
            "audio",
            "night-light",
            "dnd",
            "power",
            "caffeine",
            "record",
            "screenshot",
            "picker",
            "dark",
            "dnd-quick",
            "airplane",
            "keyboard",
            "clipboard",
            "mic-mute"
          ]
        },
        "uniqueItems": true,
        "maxItems": 16
      }
    },
    "osd": {
      "title": "On-screen display",
      "page": "osd",
      "keywords": [],
      "default": {
        "volume-step": 3,
        "volume-max": 150,
        "brightness-step": 3,
        "gamma-min": 10
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "volume-step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "volume-max": {
            "type": "integer",
            "minimum": 100,
            "maximum": 150
          },
          "brightness-step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          },
          "gamma-min": {
            "type": "integer",
            "minimum": 10,
            "maximum": 90
          }
        },
        "required": [
          "volume-step",
          "volume-max",
          "brightness-step",
          "gamma-min"
        ],
        "additionalProperties": false
      }
    },
    "notifications": {
      "title": "Notifications",
      "page": "notifications",
      "keywords": [],
      "default": {
        "do-not-disturb": false,
        "popup-duration": 5,
        "sounds": true
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "do-not-disturb": {
            "type": "boolean"
          },
          "popup-duration": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "sounds": {
            "type": "boolean"
          }
        },
        "required": [
          "do-not-disturb",
          "popup-duration",
          "sounds"
        ],
        "additionalProperties": false
      }
    },
    "quiet-schedule": {
      "title": "Quiet schedule",
      "page": "notifications",
      "keywords": [],
      "default": {
        "enabled": false,
        "start": "22:00",
        "end": "07:00",
        "repeat": "every-day",
        "fullscreen": false
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "start": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
            "minLength": 5,
            "maxLength": 5
          },
          "end": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
            "minLength": 5,
            "maxLength": 5
          },
          "repeat": {
            "enum": [
              "every-day",
              "weekdays",
              "weekends"
            ]
          },
          "fullscreen": {
            "type": "boolean"
          }
        },
        "required": [
          "enabled",
          "start",
          "end",
          "repeat",
          "fullscreen"
        ],
        "additionalProperties": false
      }
    },
    "priority-notifications": {
      "title": "Priority notifications",
      "page": "notifications",
      "keywords": [],
      "default": {
        "calls": true,
        "apps": []
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "calls": {
            "type": "boolean"
          },
          "apps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "\\S",
                  "not": {
                    "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                  }
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "\\S",
                  "not": {
                    "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
                  }
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          }
        },
        "required": [
          "calls",
          "apps"
        ],
        "additionalProperties": false
      }
    },
    "ai-ring": {
      "title": "AI quota rings",
      "page": "ai-ring",
      "keywords": [],
      "default": {
        "pinned": [],
        "low-percent": 20,
        "show-used": false,
        "ring-order": "5h-inner"
      },
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pinned": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "\\S",
              "not": {
                "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
              }
            },
            "uniqueItems": true,
            "maxItems": 3
          },
          "low-percent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "show-used": {
            "type": "boolean"
          },
          "ring-order": {
            "enum": [
              "5h-outer",
              "5h-inner"
            ]
          }
        },
        "required": [
          "pinned",
          "low-percent",
          "show-used",
          "ring-order"
        ],
        "additionalProperties": false
      }
    }
  }
}
